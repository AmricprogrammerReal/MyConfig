general {
    colors = true
    interval = 5
    color_good = "#00ff00"
    color_degraded = "#ffff00"
    color_bad = "#ff0000"
}

order += "wireless _first_"
order += "disk /"
order += "cpu_usage"
order += "load"
order += "memory"
order += "volume master"
order += "tztime local"

wireless _first_ {
    format_up = "W: %essid %ip"
    format_down = "W: down"
}

disk "/" {
    format = "DISK: %avail"
}

cpu_usage {
    format = "CPU: %usage"
}

load {
    format = "LOAD: %1min"
}

memory {
    format = "RAM: %used / %total"
}

volume master {
    format = "VOL: %volume"
    format_muted = "VOL: muted"
    device = "default"
}

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}
